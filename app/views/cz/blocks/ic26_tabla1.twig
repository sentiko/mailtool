{%- block ic26_tabla1 ~%}
                          <tr pik-mail-block="cz25-table1">
                            <th valign="top" style="text-align:left;margin:0;padding:0;" align="center">
                              <table valign="top" align=center cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:100%; width:100%; margin:0; background-color:{{blocks[index].mcolor}};" role="presentation">
                                <tbody>{% if blocks[index].mtop != "0" ~%}
                                  <tr pik-block-inner="table1-margin-top" style="background-color:transparent;">
                                    <th valign="top" style="text-align:left;font-size:1px;line-height:1px" height="{{blocks[index].mtop}}">&nbsp;</th>
                                  </tr>{% endif ~%}
                                  <tr pik-block-inner="table1-txt">
                                    <th valign="top" style="width:100%;">
                                        <table style="display:table; box-sizing:border-box; text-indent:0; text-align:center; border-collapse:collapse; border:0;line-height:1.5; width:{{ blocks[index].width_pc }}%; margin-left:auto;margin-right:auto; background-color:{{blocks[index].cellcolor}};">
                                            <tbody pik-this="for-loop">
                                                {%- for i in 1..5 ~%}
                                                <tr style="height:{{blocks[index].height}}px;">
                                                {%- for k in blocks[index].columns|keys -%}
                                                {%- if blocks[index].columns[k].coltype ==  "spacer" ~%}
                                                    <td style="width:{{blocks[index].columns[k].width_pc}}%;background-color:{{blocks[index].columns[k].bgcolor}};border:0;"></td>
                                                {%- elseif blocks[index].columns[k].coltype ==  "info" ~%}
                                                    <td style="padding:{{blocks[index].cellpadding}}px;background-color:{{blocks[index].columns[k].bgcolor}};width:{{blocks[index].columns[k].width_pc}}%;border-top: 3px solid #e1e0e2; {% if k == 1 %}border-right: 3px solid #e1e0e2;{% endif %}">
                                                      <span style="font-family:{{blocks[index].columns[k].font|raw}};font-weight:{{blocks[index].columns[k].fontweight}};font-size:{{blocks[index].columns[k].fontsize}}px;line-height:{{blocks[index].height}}px; color: {{blocks[index].columns[k].color}};" class="{{blocks[index].txtclass}}">{{blocks[index].columns[k].txt}}</span>
                                                    </td>
                                                {%- endif ~%}
                                                {%- endfor ~%}
                                                </tr>
                                                {%- endfor ~%}
                                            </tbody>
                                        </table>
                                    </th>
                                  </tr>{% if blocks[index].mbottom != "0" ~%}
                                  <tr pik-block-inner="table1-margin-bottom" style="background-color:transparent;">
                                    <th valign="top" style="text-align:left;font-size:1px;line-height:1px" height="{{blocks[index].mbottom}}">&nbsp;</th>
                                  </tr>{% endif ~%}
                                </tbody>
                              </table>
                            </th>
                          </tr>{% endblock -%}