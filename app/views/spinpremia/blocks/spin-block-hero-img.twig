{% block spin_hero_img ~%}
    {#- Forces mtop to include "px"  -#}
    {%- set mtop = "0" -%}
    {%- if "px" in blocks[index].mtop -%}
        {%- set mtop = blocks[index].mtop -%}
    {%- else -%}
        {%- if blocks[index].mtop != "0" -%}
          {%- set mtop = blocks[index].mtop ~ "px" -%}
        {%- endif -%}    
    {%- endif -%}
    {# Forces mbottom to include "px"  #}
    {%- set mbottom = "0" -%}
    {%- if "px" in blocks[index].mbottom -%}
        {%- set mbottom = blocks[index].mbottom -%}
    {%- else -%}
        {%- if blocks[index].mbottom != "0" -%}
          {%- set mbottom = blocks[index].mbottom ~ "px" -%}
        {%- endif -%}    
    {%- endif ~%}
                  <!-- HERO IMG -->
                  <tr>
                    <th valign="top" align="center" style="background-color: {{blocks[index].bgcolor}}; width:100%; text-align:left; margin:0 auto; padding:0;">
                      <table valign="top" cellpadding="0"  cellspacing="0"  border="0"  align="center"  role="presentation" width="{{blocks[index].width_pc}}%" style="mso-table-lspace:0pt; mso-table-rspace:0pt; border-spacing:0px; max-width:{{blocks[index].width_pc}}%;  width:{{blocks[index].width_pc}}%; margin: 0 auto; border: 0;">
                        <tbody>
                          {%- if mtop != "0" ~%}
                          <tr style="background-color:transparent;">
                            <th valign="top" style="background-color:transparent; text-align:left; font-size:1px; line-height:1px; height:1px; padding: {{mtop}} 0 0 0; ">&nbsp;</th>
                          </tr>{% endif ~%}
                          <tr>
                            <th valign="top" style="text-align:center;" align="center">
                              {%- if blocks[index].url is defined and blocks[index].url != "#" ~%}
                              <a href="{{blocks[index].url}}" alias="{{blocks[index].alias}}" target="_blank">
                              {%- endif ~%}
                                <img src="{{BaseURLimg}}{{blocks[index].img}}" alt="{{blocks[index].alt}}" width="100%"  height="auto" align="absbottom" style="line-height:0; font-size:0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; display: block;margin:0 auto; padding:0; border:0;" />
                              {%- if blocks[index].url is defined and blocks[index].url != "#" ~%}
                              </a>
                              {%- endif ~%}
                            </th>
                          </tr>
                          {%- if mbottom != "0" ~%}
                          <tr style="background-color:transparent;">
                            <th valign="top" style="background-color:transparent; text-align:left; font-size:1px; line-height:1px; height:1px; padding: 0 0 {{mbottom}} 0;">&nbsp;</th>
                          </tr>{% endif ~%}
                        </tbody>
                      </table>
                    </th>
                  </tr>{% endblock -%}
