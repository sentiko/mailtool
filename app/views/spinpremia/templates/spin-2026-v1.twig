{%- set rellenoinvisible = "&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;" -%}
<!DOCTYPE html>
<html lang="es"  dir="auto"  xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{PageTitle}}</title>
  <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/iqos">
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:AllowPNG/>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <style>
    table, td, div, h1, h2, p, a { font-family: 'IQOS', Cabin, Arial, sans-serif !important; }
  </style>
  <![endif]-->
  <!--[if !mso]><!-->
  <!--<![endif]-->
  <style>
    /* Reset */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
    th { border-collapse: collapse; }            
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }
    a img { border: 0; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; }

    /* Enlaces autodetectados (iOS / Gmail) */
    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }
    u + #body a { color: inherit; text-decoration: none; }

    /* Responsive */
    @media screen and (max-width: 600px) {
      .container { width: 100% !important; max-width: 100% !important; }
      .stack { display: block !important; width: 100% !important; }
      .px { padding-left: 20px !important; padding-right: 20px !important; }
      .h1 { font-size: 26px !important; line-height: 32px !important; }
      .btn-full { width: 100% !important; }
      {{- extraClasses ~}}
      .mbText14 { font-size:14px!important; line-height:18px!important; }
      .mbText18 { font-size:18px!important; line-height:24px!important; }
      .mbText26 { font-size:26px!important; line-height:32px!important; }
      .mbFooterTxt { line-height:14px!important; }
    }
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400..700;1,400..700&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>

<body id="body" style="background-color:{{content_bgcolor}};  word-spacing:normal; width:100%; height:100%; font-family:IQOS,Cabin,arial,sans-serif; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; padding:0; margin:0;">
  <!-- PREHEADER (texto de vista previa, oculto) -->
  {%- if config_template.Preheader is defined ~%}
  <div style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">
    {{config_template.Preheader}} 
    {{rellenoinvisible|raw}}{{rellenoinvisible|raw}}{{rellenoinvisible|raw}}
  </div>
  {%- endif ~%}
  <div role="article" aria-roledescription="email" aria-label="{{config_template.Subject}}" lang="es">
    <!-- WRAPPER EXTERIOR -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{content_bgcolor}};padding:0; margin:0;">
      <tr>
        <td align="center" style="padding:5px; margin:0 auto;">
          <!--[if mso]>
          <table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td>
          <![endif]-->
          <!-- CONTENEDOR 600px -->
          <table role="presentation" class="container" width="600px" cellpadding="0" cellspacing="0" border="0" style="width:100%;  max-width:600px;  background-color:{{content_bgcolor}};  border:0;">
            <tr>
              <td valign="top" style="padding:0; margin:0;  color:#34303D; background-color:{{content_bgcolor}};">
                <table style="mso-table-lspace:0pt;mso-table-rspace:0pt; border-spacing:0px;width:100%;table-layout:fixed !important; border:0;color:#34303D;" cellspacing="0" cellpadding="0" border="0" align="center" role="none" >
                  <!-- ::::: START COMPONENTS LOOP ::::: -->
                  {%- for index in blocks|keys ~%}
                  {#- <!-- START {{ blocks[index].type }}  --> -#}

                  {%-    if blocks[index].type ==  "spin-header" -%}
                  {{ block("spin_header"   ,       "spin-block-header.twig") -}}

                  {% elseif blocks[index].type ==  "spin-cta" -%}
                  {{ block("spin_cta"  ,           "spin-block-cta.twig") -}}

                  {% elseif blocks[index].type ==  "spin-center-img" -%}
                  {{ block("spin_center_img"  ,    "spin-block-center-img.twig") -}}

                  {% elseif blocks[index].type ==  "spin-hero-img" -%}
                  {{ block("spin_hero_img"  ,      "spin-block-hero-img.twig") -}}

                  {% elseif blocks[index].type ==  "spin-greeting" -%}
                  {{ block("spin_greeting"  ,      "spin-block-greeting.twig") -}}

                  {% elseif blocks[index].type ==  "spin-txt" -%}
                  {{ block("spin_txt"  ,           "spin-block-txt.twig") -}}

                  {% elseif blocks[index].type ==  "spin-footer" -%}
                  {{ block("spin_footer"  ,        "spin-block-footer.twig") -}}

                  {% elseif blocks[index].type ==  "spin-zyn-footer" -%}
                  {{ block("spin_zyn_footer"  ,    "spin-block-footer-zyn.twig") -}}
                  {% endif -%}

                  {% endfor ~%}
                  <!-- ::::: END COMPONENTS LOOP :::::: -->
                </table>
              </td>
            </tr>
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </div>
</body>
</html>