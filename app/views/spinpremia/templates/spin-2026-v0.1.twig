<!DOCTYPE html>
<html lang="es"  dir="auto"  xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/iqos">
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:AllowPNG/>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <style>
    table, td, div, h1, h2, p, a { font-family: 'IQOS', Arial, sans-serif !important; }
  </style>
  <![endif]-->

  <!--[if !mso]><!-->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
  <!--<![endif]-->

  <style>
    /* Reset */
    body, table, td, a { 
          -webkit-text-size-adjust: 100%; 
          -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; 
                mso-table-rspace: 0pt; 
                border-collapse: collapse; }
    th { border-collapse: collapse; }            
    img { -ms-interpolation-mode: bicubic; 
          border: 0; 
          outline: none; 
          text-decoration: none; 
          display: block; }
    a img { border: 0; }
    body { margin: 0 !important; 
           padding: 0 !important; 
           width: 100% !important; }

    /* Enlaces autodetectados (iOS / Gmail) */
    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }
    u + #body a { color: inherit; text-decoration: none; }

    /* Responsive */
    @media screen and (max-width: 600px) {
      .container { width: 100% !important; max-width: 100% !important; }
      .stack { display: block !important; width: 100% !important; }
      .px { padding-left: 20px !important; padding-right: 20px !important; }
      .h1 { font-size: 26px !important; line-height: 32px !important; }
      .btn-full { width: 100% !important; }
    }
  </style>
</head>

<body id="body" 
      class="bg-outer" 
      style="margin:0; 
             padding:0; 
             background-color: {{bgColor}}; 
             word-spacing:normal;">

  <!-- PREHEADER (texto de vista previa, oculto) -->
  <div style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">
    {{preheader}}{{rellenoinvisible}}
  </div>

  <div role="article" aria-roledescription="email" aria-label="{{subject}}" lang="es">

    <!-- WRAPPER EXTERIOR -->
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      class="bg-outer"
      style="background-color:#f4f4f7;"
    >
      <tr>
        <td align="center" style="padding:24px 12px;">

          <!--[if mso]>
          <table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td>
          <![endif]-->

          <!-- CONTENEDOR 600px -->
          <table
            role="presentation"
            class="container bg-card"
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width:100%; max-width:600px; background-color:#ffffff; border-radius:8px;"
          >


            <!-- ::::: START COMPONENTS LOOP ::::: -->
            {% for index in blocks|keys -%}
            <!-- START {{ blocks[index].type }}  -->

            {%-    if blocks[index].type ==  "spin-header" -%}
            {{ block("spin_header"   ,       "spin-block-header.twig") -}}

            {% elseif blocks[index].type ==  "spin-hero-img" -%}
            {{ block("spin_hero_img"  ,      "spin-block-hero-img.twig") -}}
            
            {% elseif blocks[index].type ==  "spin-greeting" -%}
            {{ block("spin_greeting"  ,      "spin-block-greeting.twig") -}}
            
            {% elseif blocks[index].type ==  "spin-txt" -%}
            {{ block("spin_txt"  ,           "spin-block-txt.twig") -}}
            
            {% elseif blocks[index].type ==  "spin-center-img" -%}
            {{ block("spin_center_img"  ,           "spin-block-center-img.twig") -}}
            
            {% elseif blocks[index].type ==  "spin-cta" -%}
            {{ block("spin_cta"  ,           "spin-block-cta.twig") -}}
            
            {% elseif blocks[index].type ==  "spin-footer" -%}
            {{ block("spin_footer"  ,        "spin-block-footer.twig") -}}




            
            


            <!-- BOTÓN COMPATIBLE CON OUTLOOK (VML) -->
            <tr>
              <td align="center" class="px" style="padding:8px 40px 32px 40px;">
                <!--[if mso]>
                <v:roundrect  xmlns:v="urn:schemas-microsoft-com:vml"
                              xmlns:w="urn:schemas-microsoft-com:office:word"
                              href="https://example.com/oferta" 
                              style="height:48px; 
                                      v-text-anchor:middle; 
                                      width:220px;"
                              arcsize="50%" 
                              stroke="f" 
                              fillcolor="#2563eb">
                  <w:anchorlock/>
                  <center style="color:#ffffff; font-family:Arial,sans-serif; font-size:16px; font-weight:bold;">
                    I'm Outlook
                  </center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-->
                <a href="https://example.com/oferta" 
                    target="_blank" class="btn-full"
                    style="display:inline-block; 
                          width:220px;
                          background-color:#2563eb;
                          color:#ffffff;
                          font-family:'Inter',Arial,sans-serif;
                          font-size:16px;
                          font-weight:bold;
                          line-height:48px;
                          text-align:center;
                          text-decoration:none;
                          border-radius:25px;
                          -webkit-text-size-adjust:none;
                          mso-hide:all;">
                  NOT Outlook
                </a>
                <!--<![endif]-->
              </td>
            </tr>


            {% endfor ~%}
            <!-- ::::: END COMPONENTS LOOP :::::: -->
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
