{% block iq24_footer_iqos_nofc_disclaimers %}
{# FOOTER IQOS FOREVER CURIOUS - DISCLAIMERS #}

{% if blocks[index].darkmode_img is not defined %}
    {% set darkmode_img  = "0" %}
{% else %}
    {% set darkmode_img  = blocks[index].darkmode_img %}
{% endif %}

{% if blocks[index].color is not defined %}
    {% set color  = "#34303d" %}
{% else %}
    {% set color  = blocks[index].color %}
{% endif %} 


{% if darkmode_img == "0" %}
    {# modo normal #}
    {% set footer_logo_iqos_fc    = "footer-logo-iqos.jpg" %}
{% else %}
    {# modo obscuro #}
    {% set footer_logo_iqos_fc    = "footer-logo-iqos.jpg" %}
{% endif %}


{% if target is defined and target == "DCE" %}
    {% if darkmode_img == "0" %}
        {% set footer_logo_iqos_fc    = "URL-CRM-LOGO-FOOTER-IQOS" %}
    {% else %}
          {% set footer_logo_iqos_fc  = "URL-CRM-LOGO-FOOTER-IQOS" %}
    {% endif %}
{% endif %}


{% if target is defined and target == "FSH" %}
    {% if darkmode_img == "0" %}
        {% set footer_logo_iqos_fc    = "URL-CRM-LOGO-FOOTER-IQOS" %}
    {% else %}
        {% set footer_logo_iqos_fc    = "URL-CRM-LOGO-FOOTER-IQOS" %}
    {% endif %}
{% endif %}


                        {% if blocks[index].DTI.showIluma == "1" ~%}
                        <!-- START iq24-p  DISCLAIMER - ILUMA -->
                          <tr pik-mail-block="iq24-paragraph">
                            <th valign="top" style="text-align:left;margin:0;padding:0;" align="center">
                              <table valign="top" align=center cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:100%; width:100%; margin:0; background-color:transparent;" role="presentation">
                                <tbody>
                                  <tr pik-block-inner="paragraph-margin-top" style="background-color:transparent;">
                                    <th valign="top" style="text-align:left;font-size:1px;line-height:1px" height="30">&nbsp;</th>
                                  </tr>
                                  <tr pik-block-inner="paragraph-txt">
                                    <th valign="top" style="width:100%;"  >
                                      <table  valign="middle" align="center" cellpadding="0" cellspacing="0"  style="min-width:100%; background-color:transparent;"  border="0" width="100%"  role="presentation">
                                        <tbody>
                                          <tr>
                                            <th style="text-align:center;  font-size:14px;  line-height:14px;">
                                              <div style="width:88%;  margin:0 auto;  text-align:center;  font-weight:300;  color:{{color}};  font-family: 'Noto Sans', Gotham, Arial, sans-serif; "   class="fallback-text txt_footer_fc_disc">
                                              {{blocks[index].DTI.txtIluma|raw}}
                                              </div>
                                            </th>
                                          </tr>
                                        </tbody>
                                      </table>
                                    </th>
                                  </tr>
                                  <tr pik-block-inner="paragraph-margin-bottom" style="background-color:transparent;">
                                    <th valign="top" style="text-align:left;font-size:1px;line-height:1px" height="20">&nbsp;</th>
                                  </tr>
                                </tbody>
                              </table>
                            </th>
                          </tr>
                        <!-- /END iq24-p -->
                        {% endif ~%}
